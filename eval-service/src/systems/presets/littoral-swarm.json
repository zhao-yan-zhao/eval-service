{
  "$schema": "https://f1-ai.schema/eval-system/v1.json",
  "systemId": "sys_littoral_swarm_v1",
  "name": "无人艇/机近岸集群饱和突击评估体系",
  "version": "1.2.0",
  "author": "F1 Evaluation Platform",
  "description": "面向无人集群协同渗透与近岸饱和打击推演（兼容 BS 状态帧与混合 CSV 遥测），重点考察协同同步性、走廊合规、侦打时效及突防战损。",
  "targetTags": ["无人集群", "近岸突击", "协同控制", "BS_JSONL"],
  "builtin": true,
  "kpis": [
    { "label": "敌方体系毁伤率", "atomRef": "eff.kill_efficiency", "formatter": "ratio" },
    { "label": "平台交换比", "atomRef": "eff.attrition_balance", "formatter": "ratio" },
    { "label": "编队离散度", "atomRef": "sit.formation_dispersion", "formatter": "ratio" },
    { "label": "OODA 响应延时", "atomRef": "time.detect_to_fire_latency", "formatter": "duration_sec" }
  ],
  "root": {
    "name": "集群协同作战效能",
    "weight": 1.0,
    "method": "weighted_sum",
    "children": [
      {
        "id": "dim_eff",
        "name": "饱和突击毁伤效能",
        "weight": 0.35,
        "children": [
          { "indicatorRef": "ind_mission_success_wilson", "weight": 0.30 },
          { "indicatorRef": "ind_weapon_hit_rate", "weight": 0.25 },
          { "indicatorRef": "ind_enemy_kill_eff", "weight": 0.25 },
          { "indicatorRef": "ind_attrition_exchange", "weight": 0.20 }
        ]
      },
      {
        "id": "dim_sit",
        "name": "集群阵位协同",
        "weight": 0.25,
        "children": [
          { "indicatorRef": "ind_standoff_margin", "weight": 0.35 },
          { "indicatorRef": "ind_formation_stability", "weight": 0.35 },
          { "indicatorRef": "ind_saturation_sync", "weight": 0.30 }
        ]
      },
      {
        "id": "dim_time",
        "name": "感知与打击节奏",
        "weight": 0.20,
        "children": [
          { "indicatorRef": "ind_first_detect_fast", "weight": 0.35 },
          { "indicatorRef": "ind_ooda_latency", "weight": 0.40 },
          { "indicatorRef": "ind_blind_zone_control", "weight": 0.25 }
        ]
      },
      {
        "id": "dim_comp",
        "name": "交战规则与走廊合规",
        "weight": 0.10,
        "children": [
          { "indicatorRef": "ind_corridor_compliance", "weight": 0.60 },
          { "indicatorRef": "ind_emcon_discipline", "weight": 0.40 }
        ]
      },
      {
        "id": "dim_cost",
        "name": "消耗经济性",
        "weight": 0.10,
        "children": [
          { "indicatorRef": "ind_ammo_economy", "weight": 0.50 },
          { "indicatorRef": "ind_econ_exchange_ratio", "weight": 0.50 }
        ]
      }
    ]
  }
}
