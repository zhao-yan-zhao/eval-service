  {
    "indicatorId": "ind_comp_strike_cost_eff",
    "name": "打击任务综合效费比",
    "description": "多算子复合：将攻击任务完成比率与任务分摊成本进行比值折算，反映单位成本作战产出。",
    "bindingMode": "composite",
    "atomRef": "strike.composite_mission_metrics",
    "sources": [
      {
        "alias": "strike_ratio",
        "atomRef": "strike.composite_mission_metrics",
        "reduce": "mean"
      },
      {
        "alias": "cost_alloc",
        "atomRef": "cost.mission_attrition_metrics",
        "reduce": "mean"
      }
    ],
    "composeFormula": "IF(cost_alloc > 0, (strike_ratio * 1000) / cost_alloc, strike_ratio)",
