{
  "$schema": "https://f1-ai.schema/eval-system/v1.json",
  "systemId": "sys_asw_barrier_v1",
  "name": "海上反潜巡逻与航道封锁评估体系",
  "version": "1.0.0",
  "author": "F1 Evaluation Platform",
  "description": "面向反潜机与水面警戒编队海区封锁任务，突出电磁/声学静默纪律、封锁区覆盖率、丢失重捕盲区抑制及防区外攻潜。",
  "targetTags": ["反潜封锁", "巡逻覆盖", "电磁静默"],
  "builtin": true,
  "kpis": [
    { "label": "目标丢失盲区", "atomRef": "time.blind_zone_duration", "formatter": "duration_sec" },
    { "label": "走廊合规率", "atomRef": "comp.corridor_compliance", "formatter": "ratio" },
    { "label": "首次侦获时间", "atomRef": "time.first_detection", "formatter": "duration_sec" },
    { "label": "敌潜艇毁伤比", "atomRef": "eff.kill_efficiency", "formatter": "ratio" }
  ],
  "root": {
    "name": "反潜封锁任务综合能力",
    "weight": 1.0,
    "method": "weighted_sum",
    "children": [
      {
        "id": "dim_search",
        "name": "海区控制与连续监视",
        "weight": 0.35,
        "children": [
          { "indicatorRef": "ind_first_detect_fast", "weight": 0.35 },
          { "indicatorRef": "ind_blind_zone_control", "weight": 0.35 },
          { "indicatorRef": "ind_patrol_coverage", "weight": 0.30 }
        ]
      },
      {
        "id": "dim_attack",
        "name": "攻潜杀伤效能",
        "weight": 0.30,
        "children": [
          { "indicatorRef": "ind_mission_success_wilson", "weight": 0.40 },
          { "indicatorRef": "ind_enemy_kill_eff", "weight": 0.35 },
          { "indicatorRef": "ind_attrition_exchange", "weight": 0.25 }
        ]
      },
      {
        "id": "dim_discipline",
        "name": "静默伪装与阵位协调",
        "weight": 0.25,
        "children": [
          { "indicatorRef": "ind_corridor_compliance", "weight": 0.40 },
          { "indicatorRef": "ind_emcon_discipline", "weight": 0.30 },
          { "indicatorRef": "ind_formation_stability", "weight": 0.30 }
        ]
      },
      {
        "id": "dim_cost",
        "name": "鱼雷/浮标消耗约束",
        "weight": 0.10,
        "children": [
          { "indicatorRef": "ind_ammo_economy", "weight": 1.0 }
        ]
      }
    ]
  }
}
