{
  "$schema": "https://f1-ai.schema/eval-system/v1.json",
  "systemId": "sys_bvr_air_combat_v1",
  "name": "超视距空战 (BVR) 杀伤链与费效评估体系",
  "version": "1.2.0",
  "author": "F1 Evaluation Platform",
  "description": "面向超视距空空导弹交战（如 GJ-11 vs HaveRaider BVR 对抗），覆盖 OODA 响应时效、单弹命中毁伤效能、防区外机动态势及弹药成本控制。",
  "targetTags": ["BVR空战", "超视距", "杀伤链", "EventExporter_CSV"],
  "builtin": true,
  "kpis": [
    { "label": "平台战损交换比", "atomRef": "eff.attrition_balance", "formatter": "ratio" },
    { "label": "武器直接命中率", "atomRef": "eff.hit_rate", "formatter": "ratio" },
    { "label": "首次开火耗时", "atomRef": "time.first_weapon_fire", "formatter": "duration_sec" },
    { "label": "耗弹总成本/枚数", "atomRef": "cost.munitions_cost_total", "formatter": "count" }
  ],
  "root": {
    "name": "BVR 综合推演效能",
    "weight": 1.0,
    "method": "weighted_sum",
    "children": [
      {
        "id": "dim_eff",
        "name": "杀伤链毁伤效能",
        "weight": 0.40,
        "children": [
          { "indicatorRef": "ind_weapon_hit_rate", "weight": 0.35 },
          { "indicatorRef": "ind_enemy_kill_eff", "weight": 0.30 },
          { "indicatorRef": "ind_attrition_exchange", "weight": 0.25 },
          { "indicatorRef": "ind_target_penetration", "weight": 0.10 }
        ]
      },
      {
        "id": "dim_time",
        "name": "决策与火力时效",
        "weight": 0.25,
        "children": [
          { "indicatorRef": "ind_first_fire_tempo", "weight": 0.35 },
          { "indicatorRef": "ind_first_hit_speed", "weight": 0.35 },
          { "indicatorRef": "ind_combat_duration_compact", "weight": 0.30 }
        ]
      },
      {
        "id": "dim_sit",
        "name": "战场态势占有",
        "weight": 0.20,
        "children": [
          { "indicatorRef": "ind_standoff_margin", "weight": 0.60 },
          { "indicatorRef": "ind_engagement_waves", "weight": 0.40 }
        ]
      },
      {
        "id": "dim_cost",
        "name": "交战成本控制",
        "weight": 0.15,
        "children": [
          { "indicatorRef": "ind_ammo_economy", "weight": 0.60 },
          { "indicatorRef": "ind_econ_exchange_ratio", "weight": 0.40 }
        ]
      }
    ]
  }
}
