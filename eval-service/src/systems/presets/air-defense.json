{
  "$schema": "https://f1-ai.schema/eval-system/v1.json",
  "systemId": "sys_air_defense_v1",
  "name": "区域防空反导体系拦截评估体系",
  "version": "1.0.0",
  "author": "F1 Evaluation Platform",
  "description": "面向区域防空反导阵地与预警网络对抗评估，强调早期预警感知时间、WRA 规则合规、连续截击能力及零漏防交换比。",
  "targetTags": ["防空反导", "要地防空", "预警拦截"],
  "builtin": true,
  "kpis": [
    { "label": "首次侦获时间", "atomRef": "time.first_detection", "formatter": "duration_sec" },
    { "label": "OODA 截击延时", "atomRef": "time.detect_to_fire_latency", "formatter": "duration_sec" },
    { "label": "拦截导弹命中率", "atomRef": "eff.hit_rate", "formatter": "ratio" },
    { "label": "交战波次数", "atomRef": "eff.engagement_cycles_count", "formatter": "count" }
  ],
  "root": {
    "name": "防空反导体系综合评分",
    "weight": 1.0,
    "method": "weighted_sum",
    "children": [
      {
        "id": "dim_isr",
        "name": "早期预警与连续跟踪",
        "weight": 0.30,
        "children": [
          { "indicatorRef": "ind_first_detect_fast", "weight": 0.50 },
          { "indicatorRef": "ind_blind_zone_control", "weight": 0.30 },
          { "indicatorRef": "ind_patrol_coverage", "weight": 0.20 }
        ]
      },
      {
        "id": "dim_intercept",
        "name": "拦截杀伤效率",
        "weight": 0.40,
        "children": [
          { "indicatorRef": "ind_weapon_hit_rate", "weight": 0.35 },
          { "indicatorRef": "ind_enemy_kill_eff", "weight": 0.35 },
          { "indicatorRef": "ind_attrition_exchange", "weight": 0.30 }
        ]
      },
      {
        "id": "dim_reaction",
        "name": "火力反应与合规纪律",
        "weight": 0.20,
        "children": [
          { "indicatorRef": "ind_ooda_latency", "weight": 0.50 },
          { "indicatorRef": "ind_wra_compliance", "weight": 0.30 },
          { "indicatorRef": "ind_engagement_waves", "weight": 0.20 }
        ]
      },
      {
        "id": "dim_cost",
        "name": "防空弹药费效",
        "weight": 0.10,
        "children": [
          { "indicatorRef": "ind_ammo_economy", "weight": 1.0 }
        ]
      }
    ]
  }
}
